<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>737 FMA Trainer</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f3f3;
      color: #222;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 30px 20px;
    }

    h1 {
      text-align: center;
      margin-bottom: 5px;
    }

    .subtitle {
      text-align: center;
      color: #666;
      margin-bottom: 35px;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .top-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 25px;
      font-size: 16px;
      color: #666;
    }

    .scenario {
      text-align: center;
      font-size: 28px;
      font-weight: bold;
      margin: 25px 0 30px;
    }

    .fma-labels {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3px;
      max-width: 700px;
      margin: 0 auto 4px;
      text-align: center;
      font-size: 13px;
      color: #777;
    }

    .fma {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      max-width: 700px;
      margin: auto;
      background: #444;
      padding: 3px;
    }

    .fma select {
      width: 100%;
      height: 65px;
      background: #666;
      color: #00ff4c;
      border: none;
      font-size: 20px;
      font-weight: bold;
      text-align: center;
      cursor: pointer;
    }

    .fma select:focus {
      outline: 2px solid #00ff4c;
    }

    .correct {
      background: #215d31 !important;
    }

    .wrong {
      background: #772727 !important;
    }

    .button-row {
      text-align: center;
      margin-top: 30px;
    }

    button {
      padding: 14px 32px;
      border: none;
      border-radius: 7px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      margin: 5px;
    }

    #checkButton {
      background: #222;
      color: white;
    }

    #nextButton {
      background: #3877d6;
      color: white;
      display: none;
    }

    #restartButton {
      background: #222;
      color: white;
      display: none;
    }

    .feedback {
      min-height: 30px;
      text-align: center;
      margin-top: 20px;
      font-size: 18px;
      font-weight: bold;
    }

    .correct-text {
      color: #187b35;
    }

    .wrong-text {
      color: #b02727;
    }

    .final-score {
      text-align: center;
      font-size: 38px;
      font-weight: bold;
      margin: 40px 0;
    }

    @media (max-width: 600px) {
      .scenario {
        font-size: 22px;
      }

      .fma select {
        font-size: 14px;
        height: 60px;
      }

      .card {
        padding: 20px 10px;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <h1>737 FMA Trainer</h1>
  <div class="subtitle">Autoflight Mode Practice</div>

  <div class="card">

    <div id="quizArea">

      <div class="top-row">
        <div id="questionCounter">Question 1 / 10</div>
        <div id="score">Score: 0</div>
      </div>

      <div class="scenario" id="scenario"></div>

      <div class="fma-labels">
        <div>AUTOTHROTTLE</div>
        <div>ROLL</div>
        <div>PITCH</div>
      </div>

      <div class="fma">

        <select id="at">
          <option value="">---</option>
          <option>N1</option>
          <option>ARM</option>
          <option>MCP SPD</option>
          <option>FMC SPD</option>
          <option>RETARD</option>
          <option>THR HLD</option>
          <option>GA</option>
        </select>

        <select id="roll">
          <option value="">---</option>
          <option>HDG SEL</option>
          <option>LNAV</option>
          <option>VOR/LOC</option>
          <option>FAC</option>
          <option>TO/GA</option>
        </select>

        <select id="pitch">
          <option value="">---</option>
          <option>MCP SPD</option>
          <option>V/S</option>
          <option>ALT ACQ</option>
          <option>ALT HOLD</option>
          <option>VNAV SPD</option>
          <option>VNAV PTH</option>
          <option>VNAV ALT</option>
          <option>G/S</option>
          <option>G/P</option>
          <option>TO/GA</option>
        </select>

      </div>

      <div class="feedback" id="feedback"></div>

      <div class="button-row">
        <button id="checkButton" onclick="checkAnswer()">CHECK</button>
        <button id="nextButton" onclick="nextQuestion()">NEXT</button>
      </div>

    </div>

    <div id="resultsArea" style="display:none;">
      <div class="final-score" id="finalScore"></div>

      <div class="button-row">
        <button id="restartButton" onclick="startQuiz()">TRY AGAIN</button>
      </div>
    </div>

  </div>
</div>


<script>

const questionBank = [

  {
    scenario: "CLIMB — LVL CHG + HDG SEL",
    at: "N1",
    roll: "HDG SEL",
    pitch: "MCP SPD"
  },

  {
    scenario: "DESCENT — LVL CHG + HDG SEL",
    at: "ARM",
    roll: "HDG SEL",
    pitch: "MCP SPD"
  },

  {
    scenario: "CLIMB — V/S + HDG SEL",
    at: "MCP SPD",
    roll: "HDG SEL",
    pitch: "V/S"
  },

  {
    scenario: "LEVEL FLIGHT — ALT HOLD + HDG SEL",
    at: "MCP SPD",
    roll: "HDG SEL",
    pitch: "ALT HOLD"
  },

  {
    scenario: "VNAV CLIMB — NO ALTITUDE RESTRICTIONS",
    at: "N1",
    roll: "LNAV",
    pitch: "VNAV SPD"
  },

  {
    scenario: "VNAV CLIMB — FMC ALTITUDE RESTRICTION",
    at: "MCP SPD",
    roll: "LNAV",
    pitch: "VNAV ALT"
  },

  {
    scenario: "VNAV DESCENT — ON FMC PATH",
    at: "FMC SPD",
    roll: "LNAV",
    pitch: "VNAV PTH"
  },

  {
    scenario: "DESCENT — V/S + HDG SEL",
    at: "MCP SPD",
    roll: "HDG SEL",
    pitch: "V/S"
  },

  {
    scenario: "ILS — LOCALIZER AND GLIDESLOPE CAPTURED",
    at: "MCP SPD",
    roll: "VOR/LOC",
    pitch: "G/S"
  },

  {
    scenario: "IAN — FINAL APPROACH COURSE AND GLIDEPATH CAPTURED",
    at: "FMC SPD",
    roll: "FAC",
    pitch: "G/P"
  },

  {
    scenario: "SELECTED ALTITUDE CAPTURE",
    at: "MCP SPD",
    roll: "HDG SEL",
    pitch: "ALT ACQ"
  },

  {
    scenario: "VNAV DESCENT — LEVEL AT MCP ALTITUDE",
    at: "FMC SPD",
    roll: "LNAV",
    pitch: "VNAV ALT"
  }

];


let quizQuestions = [];
let currentQuestion = 0;
let score = 0;


function shuffle(array) {
  return [...array].sort(() => Math.random() - 0.5);
}


function startQuiz() {

  quizQuestions = shuffle(questionBank).slice(0, 10);

  currentQuestion = 0;
  score = 0;

  document.getElementById("quizArea").style.display = "block";
  document.getElementById("resultsArea").style.display = "none";

  document.getElementById("restartButton").style.display = "none";

  loadQuestion();
}


function loadQuestion() {

  const q = quizQuestions[currentQuestion];

  document.getElementById("scenario").textContent = q.scenario;

  document.getElementById("questionCounter").textContent =
    `Question ${currentQuestion + 1} / ${quizQuestions.length}`;

  document.getElementById("score").textContent =
    `Score: ${score}`;

  ["at", "roll", "pitch"].forEach(id => {

    const element = document.getElementById(id);

    element.value = "";
    element.disabled = false;

    element.classList.remove("correct", "wrong");

  });

  document.getElementById("feedback").textContent = "";
  document.getElementById("feedback").className = "feedback";

  document.getElementById("checkButton").style.display = "inline-block";
  document.getElementById("nextButton").style.display = "none";

}


function checkAnswer() {

  const q = quizQuestions[currentQuestion];

  const at = document.getElementById("at");
  const roll = document.getElementById("roll");
  const pitch = document.getElementById("pitch");

  if (!at.value || !roll.value || !pitch.value) {

    document.getElementById("feedback").textContent =
      "Select all three FMA modes.";

    return;
  }

  let completelyCorrect = true;


  if (at.value === q.at) {
    at.classList.add("correct");
  } else {
    at.classList.add("wrong");
    completelyCorrect = false;
  }


  if (roll.value === q.roll) {
    roll.classList.add("correct");
  } else {
    roll.classList.add("wrong");
    completelyCorrect = false;
  }


  if (pitch.value === q.pitch) {
    pitch.classList.add("correct");
  } else {
    pitch.classList.add("wrong");
    completelyCorrect = false;
  }


  at.disabled = true;
  roll.disabled = true;
  pitch.disabled = true;


  const feedback = document.getElementById("feedback");


  if (completelyCorrect) {

    score++;

    feedback.textContent = "Correct";
    feedback.className = "feedback correct-text";

  } else {

    feedback.innerHTML =
      `Correct FMA: <strong>${q.at} | ${q.roll} | ${q.pitch}</strong>`;

    feedback.className = "feedback wrong-text";

  }


  document.getElementById("score").textContent =
    `Score: ${score}`;


  document.getElementById("checkButton").style.display = "none";
  document.getElementById("nextButton").style.display = "inline-block";

}


function nextQuestion() {

  currentQuestion++;

  if (currentQuestion >= quizQuestions.length) {
    finishQuiz();
  } else {
    loadQuestion();
  }

}


function finishQuiz() {

  document.getElementById("quizArea").style.display = "none";
  document.getElementById("resultsArea").style.display = "block";

  document.getElementById("finalScore").innerHTML =
    `Your score:<br>${score} / ${quizQuestions.length}`;

  document.getElementById("restartButton").style.display = "inline-block";

}


startQuiz();

</script>

</body>
</html>
